{
  "name": "party-trivia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "load-test": "tsx scripts/load-test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json README.md collaboration/*.md",
    "package:tester": "node scripts/package-tester.mjs",
    "test:distribution": "playwright test --config playwright.distribution.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
